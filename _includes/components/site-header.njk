<header class="site-header">
  <span class="site-header__logo-container">
    <a class="site-header__link" href="{{ '/' | url }}">
      <svg class="site-header__logo" width="36" height="36" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-label="TRP monogram">
        <rect width="36" height="36" rx="5" fill="#0D9488"/>
        <text x="18" y="18" dominant-baseline="central" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="12" fill="#F0F2F8">TRP</text>
      </svg>
        {{ metadata.title }}
      </a>
    </span>
    <nav class="site-header__nav">
      {% set navPages = collections.all | eleventyNavigation %}
      <ul class="site-header__items">
        {%- for entry in navPages %}
          <li class="site-header__item">
            <a class="site-header__link" href="{{ entry.url | url }}" {% if entry.url == page.url %} data-current="current item" {% endif %}>{{ entry.title }}</a>
          </li>
        {%- endfor %}
      </ul>
    </nav>
  </header>